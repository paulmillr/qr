{
  "name": "qr",
  "version": "0.7.0",
  "description": "Minimal zero-dependency QR generator/reader with terminal, GIF, and SVG output",
  "files": [
    "index.js",
    "index.d.ts",
    "decode.js",
    "decode.d.ts",
    "dom.js",
    "dom.d.ts",
    "src",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "devDependencies": {
    "@paulmillr/jsbt": "0.7.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.3.0",
    "bismar": "0.1.9",
    "canvas": "3.2.3",
    "global-jsdom": "26.0.0",
    "jpeg-js": "0.4.4",
    "jsdom": "26.0.0",
    "micro-packed": "0.11.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc",
    "check": "jsbt-check",
    "benchmark": "node benchmark/index.ts",
    "benchmark:batch": "node benchmark/batch.ts",
    "benchmark:size": "bismar -bsm",
    "benchmark:quality": "node benchmark/quality.ts",
    "benchmark:thirdparty": "cd benchmark/thirdparty && npm ci && node index.ts",
    "format": "prettier --write src",
    "test": "node --no-warnings test/index.ts",
    "test:bun": "bun test/index.ts",
    "test:deno": "deno --allow-env --allow-read --allow-ffi --allow-sys test/index.ts",
    "test:tsc": "cd test; npx tsc; cd compiled/test; node index.js"
  },
  "exports": {
    ".": "./index.js",
    "./decode.js": "./decode.js",
    "./dom.js": "./dom.js"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "keywords": [
    "qr",
    "code",
    "qr code",
    "qr pattern",
    "qr generator",
    "qr reader",
    "ascii",
    "gif",
    "svg",
    "camera",
    "file"
  ],
  "homepage": "https://github.com/paulmillr/qr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/qr.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "(MIT OR Apache-2.0)",
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
